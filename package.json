{
  "name": "sentinel",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "model:yamnet": "./scripts/convert-yamnet-model.sh",
    "db:migrate": "pnpm --dir packages/db run migrate:deploy",
    "db:seed:support": "pnpm --dir app/sentinel-api run seed:support",
    "db:setup:support": "pnpm run db:migrate && pnpm run db:seed:support",
    "db:prepare-real": "pnpm --dir app/sentinel-api run db:prepare-real",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf node_modules",
    "doctor": "react-doctor",
    "doctor:verbose": "react-doctor --verbose",
    "context:resolve": "node ../context-factory/scripts/context.mjs resolve",
    "context:bundle": "node ../context-factory/scripts/context.mjs bundle",
    "context:doctor": "node ../context-factory/scripts/context.mjs doctor",
    "context:bridge": "node ../context-factory/app/cli/bin/context-cli.mjs bridge --target .",
    "context:sync": "pnpm context:bridge && pnpm context:doctor",
    "context:update": "git submodule update --remote --merge ../context-factory && pnpm run context:doctor",
    "context:cli": "node ../context-factory/app/cli/bin/context-cli.mjs"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-doctor": "^0.9.12",
    "turbo": "latest",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "expo": "^54.0.33",
    "pg": "^8.19.0"
  }
}
