{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.ts": {
            "maxDuration": 60,
            "memory": 1024
        },
        "api/**": {
            "maxDuration": 60,
            "memory": 1024
        }
    },
    "crons": [
        {
            "path": "/telemetry/internal/flush",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/telemetry/internal/evidence/reconcile",
            "schedule": "15 0 * * *"
        }
    ]
}